{
  "name": "django-jqwidgets-frontend",
  "private": true,
  "description": "Angular Elements-бандл django-jqwidgets: веб-компонент <jqx-grid> на jqwidgets-ng.",
  "version": "0.1.0",
  "scripts": {
    "build": "ng build && node scripts/copy-dist.mjs",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/elements": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "jqwidgets-ng": "^27.0.1",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "typescript": "~6.0.0"
  }
}
